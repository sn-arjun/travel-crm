# TravelCRM Pro desktop app (Next.js + Electron): environment variables.
# Copy to desktop/.env.local for local work. Names and purposes only; never commit real values.
# NEXT_PUBLIC_* values are baked into the browser bundle at build time, so they are public: no secrets here.
# Features that need an optional variable switch off (or fall back to plain inputs) when it is missing.
# The backend's own variables are in backend/.dev.vars.example; the operator console's are in super-admin/.dev.vars.example.

# --- Next.js app (build time) ---
# Backend API base URL including /api/v1 (required). `fix-stack up --slot N` sets it for you.
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1
# Google Places key for AddressAutocomplete. Optional: without it address fields are plain text inputs.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Electron (runtime and installer build) ---
# Where the packaged app looks for updates; also baked into the installer by `build:desktop`. Optional:
# without it the installer gets a placeholder feed and auto-update stays off.
# TRAVELCRM_UPDATE_URL=
# Overrides Electron's user-data folder (used by the installer smoke test to keep a clean profile).
# TRAVELCRM_USER_DATA=
# The packaged app's API URL is read at runtime from <userData>/config.json, then electron/dist/build-config.json,
# then http://localhost:8787/api/v1. Set it from the app's own settings; it is not an environment variable.

# --- Tests (read by Playwright, not by the app) ---
# Stack under test; `fix-stack up --slot N` prints the matching pair. Defaults: slot 0.
# E2E_BASE_URL=http://localhost:3100
# E2E_API_URL=http://localhost:8787/api/v1
