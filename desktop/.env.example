# ═══════════════════════════════════════════════
# TravelCRM Pro — Environment Variables
# ═══════════════════════════════════════════════
# Copy to .env.local and fill in values
# Features gracefully degrade when optional vars are missing

# ── Required ──────────────────────────────────

# Backend API URL — the Hono.js API server
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1

# ── Optional (features degrade gracefully) ────

# Google Maps — Address autocomplete on forms
# Falls back to plain text inputs when missing
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ═══════════════════════════════════════════════
# BACKEND ENVIRONMENT (wrangler.toml / .dev.vars)
# ═══════════════════════════════════════════════
# The variables below are for the Cloudflare Workers backend.
# Configure in wrangler.toml (bindings) or .dev.vars (secrets).

# ── Email (SendGrid) ─────────────────────────
# Required for: invoice emails, campaign emails, visa alerts, reminders
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@travelcrm.pro    # (has hardcoded default)
# SENDGRID_FROM_NAME=TravelCRM Pro             # (has hardcoded default)
# SENDGRID_UNSUBSCRIBE_GROUP_ID=               # Required for CAN-SPAM compliance

# ── SMS & WhatsApp (Twilio) ──────────────────
# Required for: WhatsApp/SMS messaging, OTP, campaigns
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=                   # Required for OTP verification
# TWILIO_SMS_FROM_NUMBER=                      # E.164 format: +1234567890
# TWILIO_WHATSAPP_FROM_NUMBER=                 # E.164 format: +1234567890

# ── Push Notifications (Firebase) ────────────
# Required for: push notifications to mobile devices
# FCM_SERVER_KEY=

# ── Security ─────────────────────────────────
# JWT_SECRET=                                  # For unsubscribe token signing (not yet implemented)
# UNSUB_SECRET=                                # HMAC key for unsubscribe link validation
# API_BASE_URL=                                # External base URL for webhook callbacks

# ── Cloudflare D1 Bindings ───────────────────
# Configured in wrangler.toml [d1_databases]
# MASTER_DB — Master tenant registry database (required)
# Tenant DBs are resolved dynamically per request

# ── Cloudflare R2 Bindings ───────────────────
# Configured in wrangler.toml [r2_buckets]
# FILE_STORAGE — General file uploads (itinerary images, documents)
# FLEET_BUCKET — Fleet vehicle photos and driver documents
# R2_BUCKET — Marketing images and flyer assets
# R2_PUBLIC_URL=                               # Public URL prefix for R2 objects

# ── Cloudflare Queue Bindings ────────────────
# Configured in wrangler.toml [queues.producers]
# EMAIL_QUEUE — Email job processing
# SMS_QUEUE — SMS and WhatsApp message processing
# PUSH_NOTIFICATION_QUEUE — Push notification delivery
# NOTIFICATION_QUEUE — General notification processing (optional, null-safe)
# CAMPAIGN_QUEUE — Marketing campaign batch sending
# IMPORT_QUEUE — Data import file processing
# EXPORT_QUEUE — Bulk PDF and full data export
# MESSAGING_QUEUE — Fleet customer notifications

# ── Cloudflare KV Bindings ───────────────────
# Configured in wrangler.toml [kv_namespaces]
# KV — Exchange rate caching (falls back to hardcoded rates)
# CACHE — Follow-up reminder deduplication
# REPORT_CACHE — Report query result caching (5-min TTL, optional)
