{
  "name": "travelcrm-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TravelCRM Pro — Desktop & Web App (Electron + Next.js)",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev --turbopack --port 3100",
    "dev:electron": "concurrently -n next,electron -c green,blue \"next dev --turbopack --port 3100\" \"wait-on http://localhost:3100 && electron .\"",
    "build": "next build",
    "build:electron": "next build && node scripts/prepare-standalone.mjs && tsc -p electron/tsconfig.json",
    "build:desktop": "npm run build:electron && node scripts/make-icons.mjs && node scripts/run-builder.mjs",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "node scripts/build-web.mjs --preview",
    "deploy:web": "node scripts/build-web.mjs --deploy",
    "start": "next start",
    "lint": "eslint .",
    "lint:gate": "node scripts/lint-gate.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "gates": "node scripts/fix-gates.mjs",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test -c playwright.electron.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@travelcrm/shared": "*",
    "@twilio/voice-sdk": "2.18.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "6.3.9",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "electron": "34.0.0",
    "electron-builder": "^25.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  }
}
