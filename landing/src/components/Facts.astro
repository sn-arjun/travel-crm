---
import { FACTS } from '../data/content';
---
<section aria-label="What you get" class="facts">
  <div class="wrap row">
    {FACTS.map((f) => <div><span class="mono k">{f.k}</span><span class="v">{f.v}</span></div>)}
  </div>
</section>
<style>
  .facts { border-bottom: 1px solid var(--line); background: var(--card); }
  .row { padding-top: 22px; padding-bottom: 22px; display: flex; flex-wrap: wrap; gap: 14px 40px; justify-content: space-between; }
  .row > div { display: flex; align-items: baseline; gap: 10px; }
  .k { font-size: 12px; color: var(--ink2); }
  .v { font-weight: 600; font-size: 16px; }
</style>
