---
import { readingMinutes, fmtDate, tagSlug, type Post } from '../data/blog';
interface Props { list: Post[] }
const { list } = Astro.props;
---
<ol class="posts">
  {list.map((p) => (
    <li>
      <a href={`/blog/${p.id}/`} class="card">
        <span class="mono meta"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmtDate(p.data.date)}</time> · {readingMinutes(p)} min read</span>
        <span class="t">{p.data.title}</span>
        <span class="d">{p.data.description}</span>
      </a>
      <span class="tags">{p.data.tags.map((t) => <a href={`/blog/tag/${tagSlug(t)}/`} class="mono">#{t}</a>)}</span>
    </li>
  ))}
</ol>
<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  li { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 20px; display: grid; gap: 12px; align-content: start; }
  .card { display: grid; gap: 8px; color: var(--ink); text-decoration: none; }
  .card:hover .t { color: var(--runway); }
  .meta { font-size: 12px; color: var(--ink2); }
  .t { font-family: var(--display); font-weight: 800; font-size: 28px; line-height: 1.02; text-transform: uppercase; }
  .d { color: var(--ink2); font-size: 15px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px 12px; }
  .tags a { font-size: 12px; color: var(--ink2); min-height: 32px; display: inline-flex; align-items: center; }
</style>
