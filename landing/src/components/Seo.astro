---
/**
 * Head tags for every page: title, description, canonical, hreflang alternates, Open Graph, Twitter and JSON-LD.
 * Absolute URLs come from `site` in astro.config.mjs (the domain in public/config.js).
 */
interface Props {
  title: string;
  description: string;
  /** hreflang → path, e.g. { 'en-GB': '/uk/' }. The page itself should be one of them. */
  alternates?: Record<string, string>;
  jsonLd?: Record<string, unknown>[];
  ogImageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, alternates, jsonLd = [], ogImageAlt = 'TravelCRM Pro departures board: enquiries moving from quoted to booked to paid', type = 'website', noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const og = new URL('/og-image.png', site).href;
const fullTitle = title.includes('TravelCRM Pro') ? title : `${title} | TravelCRM Pro`;
---
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
{alternates && Object.entries(alternates).map(([lang, path]) => <link rel="alternate" hreflang={lang} href={new URL(path, site).href}>)}
<meta property="og:type" content={type}>
<meta property="og:site_name" content="TravelCRM Pro">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={og}>
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={og}>
{jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
