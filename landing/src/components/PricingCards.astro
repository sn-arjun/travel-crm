---
import { MARKETS, MARKET, PLAN_META, num, type MarketKey } from '../data/markets';
import { bindings } from '../scripts/bind';
import { featuresInPlan, FEATURE_TOTAL } from '../data/features';
interface Props { market: MarketKey; heading?: 'h1' | 'h2' }
const { market, heading = 'h2' } = Astro.props;
const b = bindings(MARKET[market]);
const H = heading;
---
<div class="head">
  <div><p class="eyebrow">PRICING · ONE PRICE PER AGENCY, PER YEAR</p>
  <H class="h2">Pick your class.</H></div>
  <div role="group" aria-label="Show prices for" class="seg">
    {MARKETS.map((m) => <button type="button" data-pick-market={m.key} aria-pressed={m.key === market ? 'true' : 'false'}>{m.label}</button>)}
  </div>
</div>
<div class="cards">
  {PLAN_META.map((p, i) => (
    <article class={`card ${'popular' in p ? 'pop' : ''}`}>
      <div class="main">
        <div class="cls"><span class="mono">{p.cls}</span>{'popular' in p && <span class="badge mono">MOST BOOKED</span>}</div>
        <h3>{p.name}</h3>
        <p class="best" data-bind={`bestFor.${i}`}>{b[`bestFor.${i}`]}</p>
        <div class="price" data-bind-label={`priceLabel.${i}`} aria-label={b[`priceLabel.${i}`]}>
          <span aria-hidden="true" class="mono amount" data-bind={`price.${i}`} data-tiles data-shown={b[`price.${i}`]}>{b[`price.${i}`]}</span>
          <span class="per">/ year <span data-bind="tax">{b.tax}</span></span>
        </div>
        <p class="founding">Founding price, locked 24 months. <s data-bind={`list.${i}`}>{b[`list.${i}`]}</s> from 1 April 2027.</p>
        <ul>
          {[<span data-bind={`usersLine.${i}`}>{b[`usersLine.${i}`]}</span>, `${num(p.ai)} AI credits a month`, `${num(p.wa)} WhatsApp templates and ${num(p.mail)} emails a month`, `${p.web} ${p.web === 1 ? 'website' : 'websites'} run from the CRM`, p.extra].map((ln) => (
            <li><svg class="check" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>{ln}</span></li>
          ))}
        </ul>
        <a href="#compare" class="all">{featuresInPlan((i + 1) as 1 | 2 | 3)} of {FEATURE_TOTAL} features: see them all ↓</a>
      </div>
      <div class="stub">
        <span class="notch t" aria-hidden="true"></span><span class="notch b" aria-hidden="true"></span>
        <div class="mono gate">GATE<br><strong>{p.gate}</strong><br>SEATS<br><strong data-bind={`users.${i}`}>{b[`users.${i}`]}</strong></div>
        <div class="perf" aria-hidden="true"><div class="mono off"><strong>−20%</strong>FOUNDING</div></div>
        <a href="/#enquire" class="board-now">Board now</a>
      </div>
    </article>
  ))}
</div>
<p class="pnote"><span data-bind="note">{b.note}</span> Extra AI credits and WhatsApp messages come in packs, priced from cost. Ask for a 14-day trial: no card, with an onboarding call.</p>
<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px; }
  .card { display: flex; min-width: 0; background: var(--card); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; box-shadow: 0 18px 40px rgba(18,21,24,.07); }
  .card.pop { border: 2px solid var(--amber); }
  .main { flex: 1 1 auto; min-width: 0; padding: 22px 20px 20px; display: flex; flex-direction: column; }
  .cls { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12px; letter-spacing: .14em; color: var(--ink2); }
  .badge { font-size: 11px; font-weight: 600; background: var(--board); color: var(--amber); padding: 4px 8px; border-radius: 5px; letter-spacing: .04em; }
  h3 { margin: 6px 0 4px; font-family: var(--display); font-weight: 900; font-size: 44px; line-height: 1; text-transform: uppercase; }
  .best { margin: 0 0 14px; font-size: 14px; font-weight: 600; }
  .price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 8px; }
  .amount { font-weight: 600; font-size: 38px; letter-spacing: -.02em; }
  .per { font-size: 14px; color: var(--ink2); }
  .founding { margin: 6px 0 16px; font-size: 13px; color: var(--ink2); }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14px; }
  li { display: grid; grid-template-columns: 18px minmax(0,1fr); gap: 8px; }
  .all { margin-top: auto; padding-top: 16px; font-size: 14px; font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .stub { flex: 0 0 112px; position: relative; border-left: 2px dashed var(--line); background: var(--chip); color: var(--ink); padding: 20px 12px; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; }
  .pop .stub { background: var(--board); color: var(--amber); }
  .notch { position: absolute; left: -11px; width: 20px; height: 20px; border-radius: 50%; background: var(--paper); }
  .notch.t { top: -11px; } .notch.b { bottom: -11px; }
  .gate { font-size: 10px; letter-spacing: .1em; line-height: 1.7; }
  .gate strong { font-size: 15px; }
  .perf { height: 74px; transform: rotate(-4deg); }
  .off { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: var(--red); font-size: 9px; line-height: 1.3; }
  .off strong { font-size: 15px; }
  .board-now { color: inherit; font-weight: 700; font-size: 13px; text-align: center; text-decoration: underline; min-height: 44px; display: flex; align-items: center; justify-content: center; }
  .pnote { margin: 22px 0 0; font-size: 14px; color: var(--ink2); max-width: 82ch; }
</style>
