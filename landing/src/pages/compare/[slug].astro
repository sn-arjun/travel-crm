---
import Base from '../../layouts/Base.astro';
import { COMPARISONS, type Comparison } from '../../data/compare';
import { CRUMBS_LD } from '../../data/seo';
export function getStaticPaths() {
  return COMPARISONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Comparison };
const site = Astro.site!;
const others = COMPARISONS.filter((o) => o.slug !== c.slug);
---
<Base title={c.title} description={c.description} jsonLd={[CRUMBS_LD(site, [['Home', '/'], ['Compare', '/compare/'], [c.title, `/compare/${c.slug}/`]])]}>
  <section class="dark">
    <div class="wrap section top">
      <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/">Home</a> / <a href="/compare/">Compare</a></nav>
      <h1 class="h2">{c.title}</h1>
      <p class="lede" style="margin-top:20px;max-width:64ch">{c.verdict}</p>
    </div>
  </section>
  <div class="wrap section">
    <h2 class="h3">What changes on day one</h2>
    <ol class="day">{c.dayOne.map((t, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{t}</li>)}</ol>
    <h2 class="h3" style="margin-top:56px">Job by job</h2>
    <div class="box" tabindex="0" role="region" aria-label={`${c.title}, job by job`}>
      <table>
        <thead><tr><th scope="col">Job</th><th scope="col">{c.name.replace(/^a /, '').replace(/^./, (s) => s.toUpperCase())}</th><th scope="col" class="us">TravelCRM Pro</th></tr></thead>
        <tbody>{c.rows.map(([job, them, us]) => <tr><th scope="row">{job}</th><td>{them}</td><td class="us">{us}</td></tr>)}</tbody>
      </table>
    </div>
    <div class="cta">
      <a class="btn btn--amber" href="/#enquire">Book a 20-minute demo</a>
      <a class="btn btn--line" href="/features/">See all features</a>
    </div>
    <p class="more">Also compare: {others.map((o, i) => <>{i ? ' · ' : ''}<a href={`/compare/${o.slug}/`}>{o.name}</a></>)}</p>
  </div>
</Base>
<style>
  .top { padding-bottom: 64px; }
  .crumbs { font-size: 13px; color: var(--boardmute); margin-bottom: 14px; }
  .crumbs a { color: var(--boardmute); }
  .day { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .day li { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px; font-size: 16px; display: grid; gap: 8px; }
  .day .mono { color: var(--amber); background: var(--board); justify-self: start; padding: 2px 7px; border-radius: 4px; font-size: 12px; }
  .box { margin-top: 20px; overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
  table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: 15px; }
  th, td { text-align: left; padding: 12px 16px; border-top: 1px solid var(--line); vertical-align: top; }
  thead th { background: var(--board); color: var(--boardtext); border-top: 0; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  thead th.us { color: var(--amber); }
  td.us { background: rgba(255,178,26,.08); font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .btn--line { color: var(--ink); border: 1px solid var(--line); background: transparent; }
  .more { margin-top: 24px; color: var(--ink2); }
</style>
