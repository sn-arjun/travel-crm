# Local secrets and settings for `wrangler dev` (backend/).
#
#   cp backend/.dev.vars.example backend/.dev.vars
#
# .dev.vars is gitignored. Never commit real values, and never put production secrets in it.
# The values below are safe local placeholders. Names come from backend/src/types.ts (interface Env).
# Needed by `npm run dev:api`, `wrangler dev` and `node desktop/scripts/fix-stack.mjs up` (the local stack reads the login
# secrets from here). NOT needed by the backend tests or the fresh-clone check, which bring their own test-only values.
# Production: secrets are pushed with scripts/push-secrets.sh; every plain setting is written into the generated config by
# backend/scripts/gen-wrangler.mjs (from GitHub variables in CI). Nothing is set by hand.

# --- Mode ---
# single = one D1 database holds everything (local default). multi = one D1 database per agency.
TENANCY_MODE=single
# Enables /api/v1/test/* (reset, outbox). Local and CI only. Never set in production.
TEST_MODE=true
ENVIRONMENT=development
# Production refuses TENANCY_MODE=single unless this is "true".
# ALLOW_SINGLE_TENANT_PRODUCTION=
# Set to 1 to apply the real rate limits locally (default multiplier is 1000).
# RATE_LIMIT_MULTIPLIER=

# --- Login tokens (required) ---
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=local-dev-jwt-refresh-secret-change-me-0123456789
# Signs super admin tokens; must be the same value in super-admin/.env.local.
SUPER_ADMIN_JWT_SECRET=local-dev-super-admin-secret-change-me-0123456789
# Seed/contact address of the platform owner account.
SUPER_ADMIN_EMAIL=owner@example.test

# --- Credential encryption (agency provider keys stored in the database) ---
# CREDENTIALS_KEYS is JSON: {"k1":"<base64 of 32 random bytes>"}. Generate one with:
#   node -e "console.log(JSON.stringify({k1: require('crypto').randomBytes(32).toString('base64')}))"
CREDENTIALS_KEYS=
CREDENTIALS_ACTIVE_KEY_ID=k1

# --- Addresses ---
APP_URL=http://localhost:3100
# Base of shared quotation links (default: APP_URL/q).
QUOTES_URL=
# Base of the public booking pages /book/<token> (default: APP_URL).
PUBLIC_PAGES_URL=
# Cloudflare Turnstile for the public booking form (optional; without them the form relies on a honeypot and a minimum fill time).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
API_PUBLIC_URL=http://localhost:8787
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=
# "true" accepts any http://localhost:* / 127.0.0.1:* origin (local only).
ALLOW_LOOPBACK_ORIGINS=true

# --- Email (SendGrid). Blank key: system mail goes to GET /api/v1/test/outbox when TEST_MODE=true ---
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
PLATFORM_SUPPORT_EMAIL=
# Public key that verifies SendGrid event webhooks.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Shared secret in the SendGrid Inbound Parse URL (/webhooks/inbound/email/:secret).
INBOUND_EMAIL_SECRET=
# HMAC key of the unsubscribe links in marketing messages. Blank: derived from JWT_SECRET (set it in production).
UNSUB_SECRET=

# --- SMS, WhatsApp, login codes (Twilio). Blank: nothing is sent ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
# Optional alternative provider (Plivo).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SMS_FROM_NUMBER=
PLIVO_WHATSAPP_FROM_NUMBER=
# WhatsApp through Meta's Cloud API (optional; agencies can also connect their own account in Settings > Integrations).
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_GRAPH_VERSION=
# Declared in src/types.ts but not read by any code yet; leave blank.
OTP_DELIVERY=

# --- Other providers (all optional; features switch off when blank) ---
FCM_SERVER_KEY=
DEEPGRAM_API_KEY=
# Claude API key for AI features that call Anthropic directly. AI usage is metered in credits.
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
# Cloudflare Turnstile secret for the landing form; when set, the widget becomes mandatory.
TURNSTILE_SECRET=

# --- Agency database provisioning (production only) ---
# "cloudflare" creates a D1 database per new agency through the Cloudflare API.
TENANT_PROVISIONER=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_WORKER_SCRIPT_NAME=

# --- WordPress sites (Tier 3, R309) ---
# Base URL of the provisioner on the Oracle VM (no path) and the secret both sides share (24+ random characters,
# for example `openssl rand -hex 32`). Blank = "Create website" fails with a visible "not set" message.
OCI_PROVISIONER_URL=
PROVISIONER_SECRET=
# Agency sites live at <subdomain>.<this domain>.
WP_SITES_DOMAIN=

# --- Operations ---
# Shared secret for GET /api/v1/health/deep when no super admin token is used.
HEALTH_TOKEN=
# Where server errors are reported; blank = structured log line only.
ERROR_REPORTER_DSN=
# Hour (0-23, agency local time) at which daily jobs run. Default 9.
DAILY_JOB_HOUR=
APP_VERSION=

# --- Subscription billing (leave blank locally: the in-process mock gateway is used when TEST_MODE=true) ---
# 'mock' forces the mock gateway. Local and tests only: gen-wrangler REFUSES it for staging and production.
BILLING_GATEWAY=
# Signs mock-gateway events. Local only: push-secrets.sh never pushes it.
BILLING_MOCK_SECRET=local-dev-billing-mock-secret-0123456789
# Real gateways (use TEST keys here, never live ones).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Platform tax on subscription invoices. Blank = defaults (country IN, GST 18, no VAT, grace 7 days).
PLATFORM_TAX_COUNTRY=
PLATFORM_TAX_STATE=
PLATFORM_TAX_ID=
PLATFORM_GST_RATE=
PLATFORM_VAT_COUNTRIES=
PLATFORM_VAT_RATE=
BILLING_GRACE_DAYS=

# --- Calling (Twilio resale) ---
# 'mock' selects the in-memory VoIP provider (local only; never in production).
VOIP_PROVIDER=
# Countries where calling is offered, e.g. US or US,GB. '*' = all (honoured outside production only).
# Blank = code default GB,US,AU,SG. Deployed environments get US from gen-wrangler unless you set it.
VOIP_CALLING_COUNTRIES=

# --- System mail routing ---
# sendgrid | cloudflare | mock. Blank = the code default. gen-wrangler writes cloudflare for deployed environments.
EMAIL_SYSTEM_PROVIDER=
# Domain that receives agency replies through Cloudflare Email Routing (reply+<token>@<domain>).
EMAIL_INBOUND_DOMAIN=
