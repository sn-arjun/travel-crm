{
  "name": "travelcrm-api",
  "version": "1.0.0",
  "description": "TravelCRM Pro — Cloudflare Workers API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/predeploy-guard.mjs production && wrangler deploy -c .wrangler.production.toml --env production",
    "deploy:staging": "node scripts/predeploy-guard.mjs staging && wrangler deploy -c .wrangler.staging.toml --env staging",
    "deploy:production": "node scripts/predeploy-guard.mjs production && wrangler deploy -c .wrangler.production.toml --env production",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-tenants.mjs --local",
    "db:studio": "drizzle-kit studio",
    "gen:wrangler": "node scripts/gen-wrangler.mjs",
    "migrate:tenants": "node scripts/migrate-tenants.mjs",
    "db:bundle-tenant": "node scripts/bundle-tenant-migrations.mjs",
    "test:gen-wrangler": "node scripts/gen-wrangler.selftest.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "hono": "^4.12.0",
    "jose": "^6.1.3",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.5",
    "uuidv7": "^1.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.21",
    "@cloudflare/workers-types": "^4.20260219.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdfmake": "^0.3.1",
    "@vitest/expect": "2.1.8",
    "@vitest/runner": "2.1.8",
    "@vitest/snapshot": "2.1.8",
    "@vitest/spy": "2.1.8",
    "@vitest/ui": "2.1.8",
    "@vitest/utils": "2.1.8",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3",
    "vitest": "2.1.8",
    "wrangler": "^4.148.0"
  }
}
