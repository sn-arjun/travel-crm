# Copy to .env next to docker-compose.shared.yml and fill in. Generate each password with: openssl rand -hex 24
WP_DB_ROOT_PASSWORD=
WP_DB_PASSWORD=
# Must equal PROVISIONER_SECRET on the API Worker (openssl rand -hex 32)
PROVISIONER_SECRET=
# Agency sites become <slug>.<WP_SITES_DOMAIN>; the same value is WP_SITES_DOMAIN on the API Worker
WP_SITES_DOMAIN=sites.example.com
# Optional; default network.<WP_SITES_DOMAIN>
WP_NETWORK_HOST=
# Owns the WordPress network (super admin). Receives the password-set e-mail.
WP_NETWORK_ADMIN_EMAIL=
# Public host name of the provisioner API; its https address is OCI_PROVISIONER_URL on the API Worker
PROVISIONER_HOST=wp-api.example.com
ACME_EMAIL=
# Hard cap on sites (default derived from memory: 88 on 12 GB). The compose file uses 60 unless set.
MAX_SITES=60
WP_DATA_DIR=/opt/wp-shared
