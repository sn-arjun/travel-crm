desktop/audit/remake/.vitest-run.json

# Local dev secrets, generated by scripts/sync-config.sh from terraform.tfvars.
# README described this as gitignored, but it was actually tracked — every key
# it holds is in git history and should be rotated if this repo is shared.
.dev.vars
**/.dev.vars
dist/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Per-environment files hold names and regions only, never secrets
!terraform/environments/*.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

