# TravelCRM Pro — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# --- Backend (Cloudflare Workers secrets — set via `wrangler secret put`) ---
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
FCM_SERVER_KEY=your-firebase-server-key

# --- Flutter (passed via --dart-define at build time) ---
# API_BASE_URL=http://localhost:8787
# ENVIRONMENT=dev

# --- Terraform (set as env vars or in terraform.tfvars) ---
# TF_VAR_oci_tenancy_ocid=ocid1.tenancy.oc1..aaaa...
# TF_VAR_cloudflare_api_token=your-cf-api-token
# TF_VAR_cloudflare_account_id=your-cf-account-id

# --- CI/CD (GitHub Actions secrets) ---
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# OCI_TENANCY_OCID
# OCI_USER_OCID
# OCI_FINGERPRINT
# OCI_PRIVATE_KEY
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
