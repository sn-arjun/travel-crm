# TravelCRM Pro: where each environment variable lives.
#
# There is no root .env file. Each app has its own example file; copy the one you need.
# Names and purposes only: never commit real values, and keep secrets out of NEXT_PUBLIC_* and landing/config.js.
#
#   backend/.dev.vars.example          Worker secrets and settings (JWT, SendGrid, Twilio, Deepgram, Anthropic, CORS, tenancy)
#   desktop/.env.example               Next.js / Electron variables (NEXT_PUBLIC_API_URL, NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, update feed)
#   super-admin/.dev.vars.example      Operator console (SUPER_ADMIN_JWT_SECRET, BACKEND_API_URL)
#   landing/config.js                  Public landing page settings (apiBase, siteUrl, contact, WhatsApp, Turnstile SITE key)
#   packages/driver_app/android/key.properties.example   Android release signing for the driver app
#   terraform/terraform.tfvars.example Cloud infrastructure inputs
#
# Local development needs none of them: `node desktop/scripts/fix-stack.mjs up` and the test suites
# pass their own values. See README.md.

# --- Flutter driver app (passed with --dart-define at build time) ---
# API_BASE_URL=http://localhost:8787   # backend origin without /api/v1 (default; see lib/core/constants/app_config.dart)

# --- Terraform (environment variables or terraform.tfvars) ---
# TF_VAR_oci_tenancy_ocid=
# TF_VAR_cloudflare_api_token=
# TF_VAR_cloudflare_account_id=

# --- CI/CD (GitHub Actions secrets and variables; deploy workflows are manual workflow_dispatch) ---
# Secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, OCI_TENANCY_OCID, OCI_USER_OCID, OCI_FINGERPRINT, OCI_PRIVATE_KEY,
#   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, CF_D1_MASTER_ID, CF_KV_CACHE_ID, CF_KV_SESSIONS_ID, CF_KV_REPORT_CACHE_ID,
#   plus the Worker secrets pushed by scripts/push-secrets.sh (JWT_SECRET, JWT_REFRESH_SECRET, SENDGRID_API_KEY,
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, FCM_SERVER_KEY, ...).
# Variables: API_URL (for example https://api.example.com), APP_URL, CORS_ORIGINS, EMAIL_FROM
